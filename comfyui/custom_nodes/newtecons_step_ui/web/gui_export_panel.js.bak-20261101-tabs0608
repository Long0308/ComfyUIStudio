const DOMAINS = new Set(["newtecons_live_action", "jenniejoy_cartoon_3d"]);
const SHA = /^[a-f0-9]{64}$/;
const SAFE = /^[A-Za-z0-9_.-]+$/;
let dock, last = "", runtime = [], runtimeExport = null, activeStep = "01";
const bound = new Map(), early = new Map();
let pending = 0;
const VIDEO_STEPS = [
  { code: "01", label: "VÀO", ids: [[5, "LoadImage"], [8, "LoadImage"], [31, "LoadImage"], [32, "LoadImage"], [33, "LoadImage"], [34, "LoadImage"]] },
  { code: "02", label: "GIỌNG", ids: [[7, "LoadAudio"]] },
  { code: "03", label: "PROMPT", ids: [[19, "PrimitiveStringMultiline"]] },
  { code: "04", label: "H3", ids: [[1, "UNETLoader"], [2, "CLIPLoader"], [3, "VAELoader"], [4, "VAELoader"],
