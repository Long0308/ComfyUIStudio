  ra.dataset.attached = String(ws?.attached ?? 0);
  out.push(el("div", { class: "nt-row" }, vao, arrow(), ra));
  out.push(el("div", { class: "nt-banner" }, el("b", { text: "ĐÍNH KÈM: " }),
    "tấm tham chiếu (ghép các ô đang BẬT) → CODEX: refs của node Codex · LOCAL: ReferenceLatent trước guider bước 02 và 06."));
  return out;
}

// ---- v005 tab 02B: the SELECTED character's own FACE / ACTION images; reference-library only via MẪU MỚI. ----
function renderCharacter(step) {
  const plan = routePlan(state.graph.extra);
  const cs = characterStatus(state.graph);
  const found = state.graph.extra?.newtecons_characters?.found;
  const out = [chips("NHÂN VẬT", plan, "character", cs?.context, "data-char"),
    chips("MẪU TẠO NHÂN VẬT MỚI (reference-library)", plan, "mau_moi", currentChoice(state.graph.extra, state.graph.nodes, "mau_moi"), "data-mau")];
  if (!found || cs?.blocked) {
    out.push(el("div", { class: "nt-warn", "data-act": "char-blocked", text: "CHƯA CÓ ẢNH NHÂN VẬT — MẶT 1 / DÁNG 1 trống ⇒ server từ chối Run luồng LOCAL. "
      + "Không tự lấy ảnh reference-library." }));
  }
  if (currentChoice(state.graph.extra, state.graph.nodes, "mau_moi") === "on") {
    out.push(el("div", { class: "nt-warn", text: "MẪU TẠO NHÂN VẬT MỚI đang BẬT: mặt/dáng lấy từ reference-library thay cho ảnh nhân vật — chỉ dùng khi tạo nhân vật MỚI." }));
  }
  const opt = plan.character.options[cs?.context] || {};
  const vao = corners(el("div", { class: "nt-slot" }, el("div", { class: "nt-lbl" }, "VÀO ", el("i", { text: `— ${opt.label || "?"} · dùng ${(opt.used || []).join(" MẶT + ")} DÁNG / có ${opt.faces ?? "?"}+${opt.poses ?? "?"}` })),
    el("div", { class: "nt-wgrid" }, (cs?.slots || []).map(slotThumb))));
  const ra = renderOutput(step);
  ra.querySelector(".nt-lbl i").textContent = `— Sau · đính kèm ${cs?.attached ?? 0} ảnh nhân vật`;
  out.push(el("div", { class: "nt-row" }, vao, arrow(), ra));
  out.push(el("div", { class: "nt-banner" }, el("b", { text: "LUỒNG: " }),
    "LOCAL — MẶT/DÁNG ghép thành tham chiếu → ReferenceLatent trước guider bước 02. CODEX — hợp đồng node: refs THAY bộ neo trang phục, nên ảnh nhân vật không gửi sang Codex."));
  return out;
}

function render() {
  if (!panel) return;
  const step = state.steps.find((s) => s.code === state.active);
  if (!step || !state.graph) { panel.hidden = true; return; }
  const members = state.graph.nodes.filter((n) => n.pos[0] >= step.bounding[0] && n.pos[0] < step.bounding[0] + step.bounding[2]
    && n.pos[1] >= step.bounding[1] && n.pos[1] < step.bounding[1] + step.bounding[3]);
  const off = members.filter((n) => n.mode === 2 || n.mode === 4).length;
  const body = [
    el("div", { class: "nt-head" }, el("span", { class: "nt-num", text: step.code }), el("span", { class: "nt-name", text: step.label }),
      el("button", { class: "nt-x", title: "Đóng", text: "×", onclick: () => { state.active = null; panel.hidden = true; paintTabs(); } })),
    el("div", { class: "nt-sub", text: `${members.length} node trong nhóm · ${off} đang tắt · ${state.kind === "video" ? "video H3" : "ảnh"} NEWTECONS live-action` }),
  ];
  const plan = state.kind === "image" ? routePlan(state.graph.extra) : null;
  if (step.num === 1 && plan) {
    const cur = currentChoice(state.graph.extra, state.graph.nodes, "route");
    body.push(el("div", { class: "nt-banner", "data-route": cur }, el("b", { text: "LUỒNG ĐANG CHỌN: " }), routeLabel(plan, cur),
      " · đổi ở tab 00 CHỌN LUỒNG."));
  } else if (step.num === 1 && ROUTE_TEXT[state.kind]) {
    body.push(el("div", { class: "nt-banner" }, el("b", { text: "ĐƯỜNG CHẠY: " }), ROUTE_TEXT[state.kind]));
  }
  if (plan && step.code === "01") body.push(el("div", { class: "nt-row" }, renderInput(step), arrow(), renderOutput(step)), renderPromptList());
  else if (plan && step.code === "00") body.push(...renderRoute(step));
  else if (plan && step.code === "02A" && plan.wardrobe) body.push(...renderWardrobe(step));
  else if (plan && step.code === "02B" && plan.character) body.push(...renderCharacter(step));
  else if (plan && step.code === "08" && plan.fix08) {
    const cur = currentChoice(state.graph.extra, state.graph.nodes, "fix08");
    body.push(chips("SỬA GÓC (Krea2, GPU local)", plan, "fix08", cur, "data-fix08"),
      el("div", { class: "nt-banner", text: "Mặc định TẮT ở cả 2 luồng (Run ở CODEX không nạp Krea2). BẬT khi đã chọn ảnh cần sửa + mask. "
        + "Tắt lại thì nguồn nối dây của bước 09 tự về bước 07." }),
      el("div", { class: "nt-row" }, renderInput(step), arrow(), renderOutput(step)));
  }
  else if (plan && step.code === "09") body.push(...renderApprove(step));
  else body.push(el("div", { class: "nt-row" }, renderInput(step), arrow(), renderOutput(step)));
  const foot = el("div", { class: "nt-foot" }, el("span", { text: "GET /history + /view. Không gửi /prompt từ bảng này; tab 00/09 chỉ đổi mute/switch trên canvas." }));
  const eng = el("div", { class: "nt-eng" });
  if (state.kind === "image" && step.code === "07") {
    foot.prepend(el("button", { class: "nt-btn", text: state.engineOpen ? "Ẩn ảnh LAN GPT" : "So với ảnh LAN GPT (r005f)",
      onclick: () => { state.engineOpen = !state.engineOpen; state.panelSig = ""; render(); } }));
  }
  body.push(foot);
  if (state.engineOpen && state.kind === "image" && step.code === "07") { body.push(eng); renderEngine(eng); }
  panel.replaceChildren(...body);
  panel.hidden = false;
  place();
}

function paintTabs() {
  if (!bar) return;
  for (const t of bar.querySelectorAll(".nt-tab")) t.classList.toggle("on", t.dataset.code === state.active);
}

function paintDots() {
  if (!bar || !state.graph) return;
  for (const t of bar.querySelectorAll(".nt-tab")) {
    const step = state.steps.find((s) => s.code === t.dataset.code);
    t.querySelector(".nt-dot")?.classList.toggle("has", Boolean(step && stepOutput(step)));
  }
}

async function selectStep(code) {
  state.active = state.active === code && !panel.hidden ? null : code;
  paintTabs();
  if (!state.active) { panel.hidden = true; return; }
  await loadHistory(true);
  state.panelSig = "";
  render();
  paintDots();
  zoomTo(state.steps.find((s) => s.code === code));
}

function buildBar() {
  bar.replaceChildren(el("span", { class: "nt-brand", text: state.kind === "video" ? "NEWTECONS · VIDEO H3" : "NEWTECONS · ẢNH" }));
  if (!state.collapsed) {
    for (const s of state.steps) {
      bar.append(el("button", { class: "nt-tab", "data-code": s.code, title: s.title, onclick: () => selectStep(s.code) },
        el("b", { text: s.code }), el("span", { text: s.label }), el("span", { class: "nt-dot" })));
    }
  }
  bar.append(el("button", { class: "nt-tool", title: state.collapsed ? "Hiện các bước" : "Thu gọn", text: state.collapsed ? "HIỆN BƯỚC ▸" : "◂",
    onclick: () => { state.collapsed = !state.collapsed; localStorage.setItem(COLLAPSE_KEY, state.collapsed ? "1" : "0"); buildBar(); place(); } }));
  paintTabs();
  paintDots();
}

function tick() {
  if (!bar || !panel) return; // afterConfigureGraph can fire before setup() built the DOM
  const snap = snapshot();
  const kind = snap ? workflowKind(snap.extra, snap.groups, activeWorkflowContext(app)) : null;
  const steps = kind ? parseSteps(snap.groups) : [];
  if (!kind || steps.length < 3) {
    if (bar) bar.hidden = true;
    if (panel) panel.hidden = true;
    state.kind = null; state.sig = "";
    return;
  }
  state.graph = snap;
  const sig = kind + "|" + JSON.stringify(steps.map((s) => [s.code, s.label, s.bounding]));
  if (sig !== state.sig) {
    state.kind = kind; state.steps = steps; state.sig = sig; state.engineOpen = false;
    state.promptText = String(snap.extra?.[PROMPT_LIST_KEY] ?? "");
    if (!steps.some((s) => s.code === state.active)) state.active = null;
    buildBar();
    loadHistory().then(paintDots);
  }
  bar.hidden = false;
  if (state.active && !panel.hidden) {
    const step = steps.find((s) => s.code === state.active);
    const psig = JSON.stringify([inputsForStep(snap, step, steps).map((i) => [i.nodeId, i.value, i.mode]),
      outputNodesForStep(snap, step).map((o) => [o.nodeId, o.prefix, o.mode]), state.historyAt,
      snap.extra?.newtecons_route || null, snap.extra?.newtecons_wardrobe_context || null,
      snap.nodes.filter((n) => n.type === "LoadImage").map((n) => [n.id, n.widgets.image, n.mode]),
      snap.nodes.filter((n) => n.widgets && "switch" in n.widgets).map((n) => [n.id, n.widgets.switch, n.mode])]);
    if (psig !== state.panelSig) { state.panelSig = psig; render(); }
  }
  place();
}

function init() {
  if (document.getElementById("nt-step-bar")) return;
  document.head.append(el("style", { id: "nt-step-ui-css", text: CSS }));
  bar = el("div", { id: "nt-step-bar", role: "tablist", "aria-label": "Các bước NEWTECONS" });
  panel = el("div", { id: "nt-step-panel" });
  bar.hidden = true; panel.hidden = true;
  document.body.append(bar, panel);
  addEventListener("resize", place);
  for (const evt of ["executed", "execution_success"]) {
    api.addEventListener(evt, () => loadHistory(true).then(() => { state.panelSig = ""; paintDots(); }));
  }
  setInterval(() => { try { tick(); } catch (err) { console.warn(`[${EXT}] tick`, err); } }, POLL_MS);
  tick();
}

app.registerExtension({
  name: EXT,
  async setup() { init(); },
  async afterConfigureGraph() { state.sig = ""; tick(); },
});
