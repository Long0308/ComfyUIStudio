// Applying a plan edits node modes / switch widgets in the CANVAS graph only (like Ctrl+M); nothing is queued.
function applyPlan(dimension, option) {
  const g = app.graph;
  const changes = planChanges(g.extra, state.graph.nodes, dimension, option);
  const live = new Map((g._nodes || g.nodes || []).map((n) => [String(n.id), n]));
  for (const m of changes.modes) {
    const n = live.get(String(m.id));
    n.properties = n.properties || {};
    if (m.saved === null) delete n.properties.nt_mode_saved;
    else if (m.saved !== undefined) n.properties.nt_mode_saved = m.saved;
    n.mode = m.mode;
  }
  for (const s of changes.switches) {
    const w = live.get(String(s.id))?.widgets?.find((x) => x.name === "switch");
    if (w) { w.value = s.value; w.callback?.(s.value); }
  }
  for (const e of changes.widgets || []) {
    for (const [name, value] of Object.entries(e.values)) {
      const w = live.get(String(e.id))?.widgets?.find((x) => x.name === name);
      if (w) { w.value = value; w.callback?.(value); }
    }
  }
  Object.assign(g.extra, changes.extra);
  g.change?.();
  g.afterChange?.();
  app.canvas?.setDirty(true, true);
  state.panelSig = "";
  tick();
  render();
}

