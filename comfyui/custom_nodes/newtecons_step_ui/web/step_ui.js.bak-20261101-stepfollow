async function shaOfRef(ref) {
  const res = await fetch(api.apiURL(viewPath(ref)), { cache: "no-store" });
  if (!res.ok) throw new Error("GET /view HTTP " + res.status);
  if (!globalThis.crypto?.subtle) throw new Error("trình duyệt không có crypto.subtle (cần http://127.0.0.1 hoặc https)");
  return hexOf(await crypto.subtle.digest("SHA-256", await res.arrayBuffer()));
}

