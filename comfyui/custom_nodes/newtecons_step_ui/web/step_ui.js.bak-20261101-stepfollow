async function pollPromptRun() {
  const run = state.promptRun;
  if (!run || run.finished) return;
  try {
    const res = await api.fetchApi("/history?max_items=200");
    const hist = res.ok ? await res.json() : {};
    run.progress = promptListProgress(hist, run.prompts, run.since, run.textNodeId);
    if (run.queuedAll && run.progress.done + run.progress.failed >= run.queued) run.finished = true;
  } catch (err) {
    console.warn(`[${EXT}] prompt-list poll`, err);
  }
  state.panelSig = "";
  render();
  if (!run.finished) run.timer = setTimeout(pollPromptRun, 2500);
}

async function runPromptList(route) {
  let prompts;
  try { prompts = parsePromptList(state.promptText); } catch (err) { state.promptMsg = String(err.message || err); render(); return; }
  if (!prompts.length) { state.promptMsg = "Danh sách trống: Run thường dùng 1 prompt ở node PROMPT."; render(); return; }
  if (route === "codex") {
    const node = graphNode((n) => n.type === "CodexOAuthImageLane");
    for (const [name, value] of Object.entries(codexMultiPromptEdits(prompts))) {
      const w = node?.widgets?.find((x) => x.name === name);
      if (w) w.value = value;
    }
    app.canvas?.setDirty(true, true);
    state.promptMsg = `CODEX: đã điền ${prompts.length} prompt vào node Codex (count=${prompts.length}). Bấm Run để gửi — tốn quota ChatGPT.`;
    render();
    return;
  }
  const node = promptNode();
  const w = node?.widgets?.find((x) => x.name === "value");
  if (!w) { state.promptMsg = "Không thấy node PROMPT (PrimitiveStringMultiline) trong nhóm 01."; render(); return; }
  const original = w.value;
  let since = -1;
  try {
    const [h, q] = await Promise.all([api.fetchApi("/history?max_items=200"), api.fetchApi("/queue")]);
    since = maxPromptNumber(h.ok ? await h.json() : {}, q.ok ? await q.json() : {});
  } catch (err) { console.warn(`[${EXT}] prompt-list since`, err); }
  const run = { prompts, since, textNodeId: node.id, queued: 0, queuedAll: false, finished: false, progress: null, results: [] };
  state.promptRun = run;
  state.promptMsg = "";
  render();
  run.results = await queuePromptsSequential({
    prompts,
    setPrompt: (text) => { w.value = text; },
    queue: () => app.queuePrompt(0, 1),
    restore: () => { w.value = original; app.canvas?.setDirty(true, true); },
    onQueued: (k) => { run.queued = k; state.panelSig = ""; render(); },
  });
  run.queuedAll = true;
  const bad = run.results.find((r) => !r.ok);
  if (bad) state.promptMsg = `Dừng ở prompt ${bad.index + 1}: ${bad.error}. Đã xếp ${run.queued} / ${prompts.length}.`;
  pollPromptRun();
}

