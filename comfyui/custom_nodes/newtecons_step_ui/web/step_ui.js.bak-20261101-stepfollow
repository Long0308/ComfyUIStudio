const state = { kind: null, steps: [], sig: "", active: null, collapsed: localStorage.getItem(COLLAPSE_KEY) === "1",
  history: null, historyAt: 0, chosenInput: new Map(), engine: null, engineOpen: false, engineChar: "CHAR_01",
  engineKind: "", panelSig: "", graph: null, promptText: "", promptRun: null, promptMsg: "", lanes: null,
  presets: undefined };
let bar = null;
let panel = null;

function el(tag, attrs = {}, ...kids) {
  const node = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (k === "class") node.className = v;
    else if (k === "text") node.textContent = v;
    else if (k.startsWith("on")) node.addEventListener(k.slice(2), v);
    else node.setAttribute(k, v);
  }
  for (const kid of kids.flat()) if (kid != null) node.append(kid);
  return node;
}

function corners(node) {
  node.classList.add("nt-frame");
  for (const c of ["tl", "tr", "bl", "br"]) node.append(el("span", { class: "nt-c " + c }));
  return node;
}

function snapshot() {
  const g = app.graph;
  if (!g) return null;
  const groups = (g._groups || g.groups || []).map((gr) => {
    const b = gr._bounding || gr.boundingRect || gr.bounding || [gr.pos?.[0], gr.pos?.[1], gr.size?.[0], gr.size?.[1]];
    return { title: gr.title, bounding: Array.from(b, Number) };
  });
  const nodes = (g._nodes || g.nodes || []).map((n) => ({
    id: n.id, type: n.type, title: n.title, mode: n.mode || 0, pos: [n.pos[0], n.pos[1]],
    widgets: Object.fromEntries((n.widgets || []).map((w) => [w.name, w.value])),
    properties: { ...(n.properties || {}) },
    inputs: (n.inputs || []).map((p) => ({ name: p.name, link: p.link ?? null })),
  }));
  const raw = g.links instanceof Map ? [...g.links.values()] : Object.values(g.links || {});
  const links = raw.filter(Boolean).map((l) => ({ id: l.id, origin_id: l.origin_id, target_id: l.target_id }));
  return { extra: g.extra || {}, groups, nodes, links };
}

function canvasRect() {
  const c = app.canvas?.canvas;
  return c ? c.getBoundingClientRect() : { top: 0, left: 0, width: innerWidth, height: innerHeight, right: innerWidth };
}

// ComfyUI 1.55 draws its menus OVER the full-window canvas: workflow tab strip on top, tool
// sidebar on the left, "Graph" breadcrumb under the tabs, optional right side panel. Measured
// (2026-10-31): tabs .workflow-tabs-container [0,0,1680,38], nav.side-tool-bar-container right 56,
// breadcrumb group [64,50,208,90], right .p-splitterpanel from x 1357. Anchor to them, ignoring ours.
function foreignAt(x, y) {
  return document.elementsFromPoint(x, y).find((e) => !e.closest("#nt-step-bar,#nt-step-panel")
    && !e.matches("canvas") && !e.classList.contains("graph-canvas-container")) || null;
}

function anchors() {
  const r = canvasRect();
  const tabs = document.querySelector(".workflow-tabs-container")?.getBoundingClientRect();
  const nav = document.querySelector(".side-tool-bar-container")?.getBoundingClientRect();
  const top = Math.max(r.top, tabs ? tabs.bottom : r.top) + 8;
  const navRight = nav && nav.width < 200 ? nav.right : r.left;
  const crumb = foreignAt(navRight + 24, top + 22)?.closest(".pointer-events-auto")?.getBoundingClientRect();
  const left = (crumb && crumb.width < 420 && crumb.left >= navRight - 2 ? crumb.right : navRight) + 8;
  const side = foreignAt(r.right - 6, Math.min(r.bottom - 40, top + 260))?.closest(".p-splitterpanel")
    ?.getBoundingClientRect();
  const rightEdge = side && side.left > r.left + r.width / 2 ? side.left : r.right;
  // Never cover the Run/queue action bar (.actionbar-container, measured [1026,46,1345,94]).
  const act = document.querySelector(".actionbar-container")?.parentElement?.getBoundingClientRect();
  let barTop = top;
  let barRight = rightEdge;
  if (act && act.width > 0 && act.top < top + 50 && act.bottom > top - 4 && act.right > left) {
    if (act.left - left >= 520) barRight = act.left;
    else barTop = act.bottom + 8;
  }
  return { r, top: barTop, left, navRight, rightEdge, barRight };
}

function place() {
  const a = anchors();
  if (bar) {
    bar.style.top = Math.round(a.top) + "px";
    bar.style.left = Math.round(a.left) + "px";
    bar.style.maxWidth = Math.max(240, Math.round(a.barRight - a.left - 8)) + "px";
  }
  if (panel && bar) {
    const b = bar.getBoundingClientRect();
    panel.style.top = Math.round(b.bottom + 10) + "px";
    panel.style.right = Math.round(innerWidth - a.rightEdge + 12) + "px";
    panel.style.maxHeight = Math.round(a.r.bottom - b.bottom - 22) + "px";
  }
}

function zoomTo(step) {
  const canvas = app.canvas;
  if (!canvas?.ds) return;
  place();
  const a = anchors();
  const r = a.r;
  const top = bar ? bar.getBoundingClientRect().bottom - r.top + 4 : 0;
  const right = panel && !panel.hidden ? r.right - panel.getBoundingClientRect().left + 8 : r.right - a.rightEdge;
  const left = Math.max(0, a.navRight - r.left);
  const target = fitBounds(step.bounding, { width: r.width, height: r.height }, { top, right, left, margin: 20 });
  const ds = canvas.ds;
  const from = { scale: ds.scale, offset: [ds.offset[0], ds.offset[1]] };
  const t0 = performance.now();
  const frame = (now) => {
    const k = Math.min(1, (now - t0) / 260);
    const e = 1 - (1 - k) ** 3;
    ds.scale = from.scale + (target.scale - from.scale) * e;
    ds.offset[0] = from.offset[0] + (target.offset[0] - from.offset[0]) * e;
    ds.offset[1] = from.offset[1] + (target.offset[1] - from.offset[1]) * e;
    canvas.setDirty(true, true);
    if (k < 1) requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);
}

async function loadHistory(force = false) {
  if (!force && state.history && performance.now() - state.historyAt < 4000) return state.history;
  try {
    const res = await api.fetchApi(`/history?max_items=${HISTORY_ITEMS}`);
    state.history = res.ok ? await res.json() : {};
  } catch (err) {
    console.warn(`[${EXT}] /history failed`, err);
    state.history = state.history || {};
  }
  state.historyAt = performance.now();
  return state.history;
}

function sessionOutput(outs) {
  for (const o of outs) {
    const out = app.nodeOutputs?.[String(o.nodeId)];
    const media = (out?.images || out?.gifs || []).filter((m) => m?.filename);
    if (media.length) return { promptId: "phiên này", nodeId: o.nodeId, nodeTitle: o.title, match: "session",
      media: media.map((m) => ({ filename: m.filename, subfolder: m.subfolder || "", type: m.type || "output",
        kind: /\.(mp4|webm|mov)$/i.test(m.filename) ? "video" : "image" })) };
  }
  return null;
}

function stepOutput(step) {
  const outs = outputNodesForStep(state.graph, step);
  return sessionOutput(outs) || latestOutput(state.history, outs, groupSignature(state.graph.groups));
}

function mediaNode(ref, kind) {
  const src = api.apiURL(viewPath(ref));
  if (kind === "video") return el("video", { src, controls: "", muted: "", loop: "", preload: "metadata" });
  if (kind === "audio") return el("audio", { src, controls: "", preload: "metadata" });
  return el("img", { src, alt: ref.filename, loading: "lazy" });
}

function renderInput(step) {
  const inputs = inputsForStep(state.graph, step, state.steps);
  const slot = corners(el("div", { class: "nt-slot" }, el("div", { class: "nt-lbl" }, "VÀO ", el("i", { text: "— Trước" }))));
  const box = el("div", { class: "nt-media" });
  if (!inputs.length) {
    box.append(el("div", { class: "nt-empty", text: "Bước này không có ảnh/âm thanh/prompt đầu vào trong nhóm và không tìm được nguồn phía trước." }));
    slot.append(box);
    return slot;
  }
  const chosenId = state.chosenInput.get(step.code);
  const cur = inputs.find((i) => i.nodeId === chosenId) || inputs.find((i) => i.value) || inputs[0];
  if (inputs.length > 1) {
    slot.append(el("div", { class: "nt-chips" }, inputs.map((i) => el("button", {
      class: "nt-chip" + (i === cur ? " on" : "") + (i.mode ? " muted" : ""), title: i.title,
      text: (i.kind === "text" ? "PROMPT " : i.kind === "audio" ? "WAV " : "ẢNH ") + "#" + i.nodeId + (i.mode ? " TẮT" : ""),
      onclick: () => { state.chosenInput.set(step.code, i.nodeId); state.panelSig = ""; render(); },
    }))));
  }
  if (cur.kind === "text") box.append(el("pre", { text: cur.value.slice(0, 1200) || "(prompt trống)" }));
  else if (!cur.value) box.append(el("div", { class: "nt-empty", text: "ĐIỀN: chưa chọn file cho node này (" + cur.title + ")." }));
  else box.append(mediaNode(cur.ref, cur.kind));
  slot.append(box, el("div", { class: "nt-cap" }, `#${cur.nodeId} ${cur.title}`, cur.value && cur.kind !== "text" ? ` · ${cur.value}` : "",
    cur.upstream ? ` · nguồn phía trước: bước ${cur.step || "?"}` : "", cur.mode ? el("span", { class: "weak", text: " · node đang TẮT" }) : null));
  return slot;
}

function renderOutput(step) {
  const slot = corners(el("div", { class: "nt-slot" }, el("div", { class: "nt-lbl" }, "RA ", el("i", { text: "— Sau" }))));
  const box = el("div", { class: "nt-media" });
  const outs = outputNodesForStep(state.graph, step);
  const hit = outs.length ? stepOutput(step) : null;
  if (!outs.length) box.append(el("div", { class: "nt-empty", text: "Nhóm này không có node lưu/xem ảnh (SaveImage / PreviewImage / SaveVideo)." }));
  else if (!hit) box.append(el("div", { class: "nt-empty", text: `Chưa có ảnh RA trong ${HISTORY_ITEMS} lượt chạy gần nhất (/history). Bảng này chỉ đọc — không gửi /prompt.` }));
  else box.append(mediaNode(hit.media[0], hit.media[0].kind));
  slot.append(box);
  if (hit) {
    const tag = hit.match === "strong" ? ["ok", "khớp: cùng workflow + node + loại"]
      : hit.match === "session" ? ["ok", "khớp: phiên này"] : ["weak", "khớp yếu: node id + loại + filename_prefix"];
    slot.append(el("div", { class: "nt-cap" }, el("span", { class: tag[0], text: tag[1] }),
      ` · #${hit.nodeId} ${hit.nodeTitle} · ${hit.media[0].subfolder ? hit.media[0].subfolder + "/" : ""}${hit.media[0].filename}`
      + ` · prompt ${String(hit.promptId).slice(0, 8)}` + (hit.media.length > 1 ? ` · +${hit.media.length - 1} file` : "")));
  }
  return slot;
}

function arrow() {
  const ns = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(ns, "svg");
  svg.setAttribute("width", "36"); svg.setAttribute("height", "24"); svg.setAttribute("viewBox", "0 0 36 24");
  const p = document.createElementNS(ns, "path");
  p.setAttribute("d", "M2 12H32M22 3L33 12L22 21"); p.setAttribute("fill", "none");
  p.setAttribute("stroke", "#5B9BF5"); p.setAttribute("stroke-width", "2.5");
  svg.append(p);
  return el("div", { class: "nt-arrow" }, svg);
}

async function renderEngine(host) {
  if (!state.engine) {
    try {
      const res = await fetch(MANIFEST_URL, { cache: "no-store" });
      state.engine = res.ok ? await res.json() : { items: [], error: "HTTP " + res.status };
    } catch (err) {
      state.engine = { items: [], error: String(err) };
    }
  }
  const m = state.engine;
  const chars = [...new Set((m.items || []).map((i) => i.char))];
  const pick = (opts, value, onchange) => el("select", { onchange }, opts.map(([v, t]) => {
    const o = el("option", { value: v, text: t });
    if (v === value) o.selected = true;
    return o;
  }));
  const items = engineFilter(m, state.engineChar, state.engineKind);
