export function el(tag, attrs = {}, ...kids) {
  const node = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (v == null || v === false) continue;
    if (k === "class") node.className = v;
    else if (k === "text") node.textContent = v;
    else if (k.startsWith("on")) node.addEventListener(k.slice(2), v);
    else node.setAttribute(k, v === true ? "" : v);
  }
  for (const kid of kids.flat()) if (kid != null && kid !== false) node.append(kid);
  return node;
}

export function arrowSvg(color) {
  const ns = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(ns, "svg");
  svg.setAttribute("width", "40"); svg.setAttribute("height", "24"); svg.setAttribute("viewBox", "0 0 40 24");
  const p = document.createElementNS(ns, "path");
  p.setAttribute("d", "M2 12H36M25 3L37 12L25 21"); p.setAttribute("fill", "none");
  p.setAttribute("stroke", color); p.setAttribute("stroke-width", "3");
  svg.append(p);
  return el("div", { class: "ntd-arrow" }, svg);
}

function rectOf(sel, pick) {
  const els = [...document.querySelectorAll(sel)];
  const e = pick ? els.find(pick) : els[0];
  if (!e) return null;
  const r = e.getBoundingClientRect();
  return { left: r.left, top: r.top, right: r.right, bottom: r.bottom, el: e };
}

function measure() {
  const vw = innerWidth;
  const vh = innerHeight;
  const sidePanel = rectOf(".side-bar-panel", (e) => e.getBoundingClientRect().width > 4);
  const rightPanel = rectOf(".p-splitterpanel", (e) => {
    const r = e.getBoundingClientRect();
    return r.width > 60 && r.left > vw * 0.55 && !e.classList.contains("p-splitterpanel-nested") && !e.querySelector("canvas")
      && !e.classList.contains("graph-canvas-panel");
  });
  // ComfyUI 1.55: the job/queue popover is a sibling of the Run bar row inside the same right-aligned column.
  const col = document.querySelector(".actionbar-container")?.closest(".items-end");
  const overlays = col ? [...col.children].filter((c) => !c.querySelector(".actionbar-container") && !c.classList.contains("actionbar-container"))
    .map((c) => c.getBoundingClientRect()).filter((r) => r.width > 4 && r.height > 4)
    .map((r) => ({ left: r.left, top: r.top, right: r.right, bottom: r.bottom })) : [];
  return {
    overlays,
    vw, vh, tabs: rectOf(".workflow-tabs-container"), action: rectOf(".actionbar-container"),
    nested: rectOf(".p-splitterpanel-nested"), sideTool: rectOf(".side-tool-bar-container", (e) => e.getBoundingClientRect().width < 200),
    sidePanel, rightPanel,
  };
}

function storeGet(k) {
  try { return localStorage.getItem(k); } catch { return null; }
}

function storeSet(k, v) {
  try { localStorage.setItem(k, v); } catch { /* storage blocked: keep in memory */ }
}

// createDock({key:"video"|"image", theme:"gold"|"blue", barId, panelId, onChange})
export function createDock({ key, theme, barId, panelId, onChange }) {
  if (!document.getElementById(CSS_ID)) document.head.append(el("style", { id: CSS_ID, text: CSS }));
  const storeKey = `newtecons.dock.${key}`;
  const themeClass = `ntd-root ntd-theme-${theme}`;
  const vars = D.themeVars(theme);
  const bar = el("div", { id: barId, class: themeClass + " ntd-bar", style: vars, role: "tablist" });
  const panel = el("div", { id: panelId, class: themeClass + " ntd-panel", style: vars });
  const handle = el("div", { class: themeClass + " ntd-handle", style: vars }, el("span", { class: "grip" }));
  bar.hidden = true; panel.hidden = true; handle.hidden = true;
  document.body.append(bar, panel, handle);
  const dock = { key, theme, bar, panel, handle, prefs: D.parsePrefs(storeGet(storeKey)), on: false, layout: null, region: null };

  dock.setPrefs = (patch) => {
    dock.prefs = D.withPrefs(dock.prefs, patch);
    storeSet(storeKey, JSON.stringify(dock.prefs));
    onChange?.();
  };

  dock.show = (on) => {
    dock.on = on;
    document.body.classList.toggle(`ntd-on-${key}`, on);
    bar.hidden = !on;
    if (!on) { panel.hidden = true; handle.hidden = true; }
  };

  dock.toolsNode = (extra = []) => el("div", { class: "ntd-tools" },
    el("button", { class: "ntd-tool" + (dock.prefs.card ? " on" : ""), title: "Hiện / ẩn thẻ INPUT", text: "INPUT",
      onclick: () => dock.setPrefs({ card: !dock.prefs.card, mode: dock.prefs.mode === "collapsed" ? "top" : dock.prefs.mode }) }),
    D.MODES.map((m) => el("button", { class: "ntd-tool" + (dock.prefs.mode === m ? " on" : ""), "data-mode": m, text: D.MODE_LABEL[m],
      title: m === "top" ? "Bảng nằm trên, graph ở dưới" : m === "right" ? "Bảng ở cạnh phải" : "Chỉ giữ thanh bước",
      onclick: () => dock.setPrefs({ mode: m }) })),
    extra);

  dock.setBar = ({ title, sub, tabs, tools }) => {
    bar.replaceChildren(
      el("div", { class: "ntd-brand" }, el("b", { text: title }), el("span", { text: sub || "", title: sub || "" })),
      el("div", { class: "ntd-tabs" }, tabs.flatMap((t, i) => [i ? el("span", { class: "ntd-link" }) : null,
        el("button", { class: "ntd-tab" + (t.on ? " on" : "") + (t.off ? " off" : ""), role: "tab", "aria-selected": String(Boolean(t.on)),
          title: t.title || `${t.code} ${t.label}`, "data-code": t.code, onclick: t.onClick }, el("b", { text: t.code }), el("span", { text: t.label }))])),
      dock.toolsNode(tools || []));
    dock.fitTabs();
  };

  // Too many tabs for the width: inactive tabs collapse to their code (full label stays in the tooltip).
  dock.fitTabs = () => {
    const strip = bar.querySelector(".ntd-tabs");
    if (!strip) return;
    strip.classList.remove("compact");
    if (strip.scrollWidth > strip.clientWidth + 2) strip.classList.add("compact");
  };

  dock.setPanel = (card, body) => {
    const mode = dock.prefs.mode;
    panel.className = `${themeClass} ntd-panel m-${mode}${dock.prefs.card && card ? " card-on" : ""}`;
    panel.replaceChildren(...(dock.prefs.card && card ? [card, body] : [body]));
    dock.place();
  };

  dock.place = () => {
    if (!dock.on) return;
    const region = D.canvasRegion(measure());
    dock.region = region;
    bar.style.left = region.left + "px";
    bar.style.top = region.top + "px";
    bar.style.width = Math.max(200, region.right - region.left) + "px";
    dock.fitTabs();
    const barH = bar.getBoundingClientRect().height || 44;
    const mode = dock.prefs.mode;
    const lay = D.dockLayout(mode, region, barH, dock.prefs);
    dock.layout = lay;
    if (!lay.panel) { panel.hidden = true; handle.hidden = true; return; }
    panel.hidden = false;
    Object.assign(panel.style, { left: lay.panel.left + "px", top: lay.panel.top + "px",
      width: lay.panel.right - lay.panel.left + "px", height: lay.panel.bottom - lay.panel.top + "px" });
    panel.style.setProperty("--media-h", D.mediaHeight(mode, lay.panel) + "px");
    handle.hidden = false;
    handle.className = `${themeClass} ntd-handle h-${mode}`;
    if (mode === "top") Object.assign(handle.style, { left: lay.panel.left + "px", top: lay.panel.bottom - 5 + "px", width: lay.panel.right - lay.panel.left + "px", height: "" });
    else Object.assign(handle.style, { left: lay.panel.left - 5 + "px", top: lay.panel.top + "px", height: lay.panel.bottom - lay.panel.top + "px", width: "" });
  };

  handle.addEventListener("pointerdown", (ev) => {
    const mode = dock.prefs.mode;
    if (mode === "collapsed" || !dock.region) return;
    ev.preventDefault();
    handle.setPointerCapture(ev.pointerId);
    handle.classList.add("drag");
    const move = (e) => {
      const f = D.fracFromDrag(mode, dock.region, { x: e.clientX, y: e.clientY });
      if (f == null) return;
      dock.prefs = D.withPrefs(dock.prefs, mode === "top" ? { topFrac: f } : { rightFrac: f });
      dock.place();
    };
    const up = () => {
      handle.classList.remove("drag");
      handle.removeEventListener("pointermove", move);
      storeSet(storeKey, JSON.stringify(dock.prefs));
    };
    handle.addEventListener("pointermove", move);
    handle.addEventListener("pointerup", up, { once: true });
  });

  // Pan/zoom the canvas so `bounding` fills the free graph area, then flash a highlight frame over it.
  dock.zoomTo = (bounding) => {
    const ds = app.canvas?.ds;
    const c = app.canvas?.canvas?.getBoundingClientRect();
    if (!ds || !c || !dock.layout || !Array.isArray(bounding) || bounding.length < 4) return false;
    const t = D.fitInto(bounding, c, dock.layout.free);
    ds.scale = t.scale; ds.offset[0] = t.offset[0]; ds.offset[1] = t.offset[1];
    app.canvas.setDirty(true, true);
    const r = D.screenRect(bounding, c, ds);
    const hl = el("div", { class: themeClass + " ntd-hl", style: `${vars};left:${r.left - 4}px;top:${r.top - 4}px;width:${r.right - r.left + 8}px;height:${r.bottom - r.top + 8}px` });
    document.body.append(hl);
    setTimeout(() => { hl.style.opacity = "0"; }, 2200);
    setTimeout(() => hl.remove(), 2900);
    return true;
  };

  // Follow ComfyUI's sidebars / panels: re-place whenever they resize or appear.
  const ro = typeof ResizeObserver === "function" ? new ResizeObserver(() => dock.place()) : null;
  const watched = new WeakSet();
  dock.watch = () => {
    if (!ro) return;
    for (const sel of [".p-splitterpanel-nested", ".side-bar-panel", ".actionbar-container", ".workflow-tabs-container", ".p-splitterpanel"]) {
      for (const e of document.querySelectorAll(sel)) if (!watched.has(e)) { watched.add(e); ro.observe(e); }
    }
  };
  addEventListener("resize", () => dock.place());
  return dock;
}
