# Copy to production-local/comfyui-docker/jj-bridge.env and fill in. NEVER commit the filled file.
# Used only by route "router" of the JJClaudeBridge node (authoring graphs).
# Your own gateway token (New-API role token or 9Router key) - not an Anthropic key.
JJ_BRIDGE_BASE_URL=http://host.docker.internal:3300
JJ_BRIDGE_MODEL=
JJ_BRIDGE_TOKEN=
# chat (default, /v1/chat/completions) or responses (/v1/responses, e.g. codex-router)
JJ_BRIDGE_API=chat
