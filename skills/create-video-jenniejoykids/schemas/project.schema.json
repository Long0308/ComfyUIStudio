        },
        "script_tracking": {
          "type": "object",
          "properties": {
            "segment_summary": {
              "type": "string",
              "minLength": 8
            },
            "dialogue_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
