          "minLength": 8
        },
        "dialogue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogue"
          },
          "minItems": 0
        },
        "music": {
          "type": "string",
          "minLength": 8
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "event": {
                "type": "string",
                "minLength": 3
              }
            },
            "required": [
              "at",
              "event"
            ]
          },
          "minItems": 0
        },
        "subtitle": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "enum": [
