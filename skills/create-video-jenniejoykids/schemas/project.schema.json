            ]
          },
          "minItems": 0
        },
        "transition": {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "minLength": 8
            },
            "camera_continuity": {
              "type": "string",
              "minLength": 8
            },
            "duration": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "intent",
            "camera_continuity",
            "duration"
          ]
        },
        "continuity": {
