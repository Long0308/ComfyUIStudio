              ]
            },
            "review_notes": {
              "type": "string",
              "minLength": 8
            }
          },
          "required": [
            "segment_summary",
            "dialogue_ids",
            "status",
            "review_notes"
          ]
        },
        "subshots": {
          "type": "array",
          "items": {
