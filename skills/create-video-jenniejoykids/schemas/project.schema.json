      "required": [
        "id",
        "start",
        "duration",
        "characters",
        "setting",
        "lighting",
        "camera",
        "action",
        "dialogue",
        "music",
        "sfx",
        "subtitle",
        "repeat_cues",
        "transition",
        "continuity",
        "script_tracking"
      ]
