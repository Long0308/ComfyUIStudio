{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jjv/schemas/episode/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "episode_id",
    "film_id",
    "title",
    "domain",
    "recipes",
    "files",
    "timeline",
    "engine_tree_sha256",
    "overrides"
  ],
  "properties": {
    "schema": {
      "const": "jjv/episode/v1"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "film_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]+/[a-z0-9][a-z0-9._-]*$"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+$"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shots",
        "mouth_boxes"
      ],
      "properties": {
        "shots": {
          "type": "string",
          "pattern": "^[^/\\\\:]+\\.json$"
        },
        "mouth_boxes": {
          "type": "string",
          "pattern": "^[^/\\\\:]+\\.json$"
        }
      }
    },
    "delivery_contract": {
      "type": "string",
      "minLength": 1
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro_s",
        "dialogue_s",
        "outro_s"
      ],
      "properties": {
        "intro_s": {
          "type": "number",
          "minimum": 0
        },
        "dialogue_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "outro_s": {
          "type": "number",
          "minimum": 0
        },
        "end_card_s": {
          "type": "number",
          "minimum": 0
        },
        "end_card_frames": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "engine_tree_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "overrides": {
      "type": "object"
    },
    "seedvr2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_version",
        "input_name_template",
        "output_prefix_template"
      ],
      "properties": {
        "production_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "input_name_template": {
          "type": "string",
          "minLength": 1
        },
        "output_prefix_template": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
