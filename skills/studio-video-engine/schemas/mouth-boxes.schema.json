{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jjv/schemas/mouth-boxes/v1",
  "$defs": {
    "keyframe": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": { "type": "integer", "minimum": 0 }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "keyframes", "active_frames"],
      "properties": {
        "role": { "enum": ["speaker", "listener"] },
        "keyframes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/keyframe" } },
        "active_frames": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "episode_id", "coordinate_space", "interpolation", "keyframe_layout", "shots"],
  "properties": {
    "schema": { "const": "jjv/mouth-boxes/v1" },
    "episode_id": { "type": "string", "minLength": 1 },
    "coordinate_space": { "type": "string", "minLength": 1 },
    "interpolation": { "const": "linear" },
    "keyframe_layout": { "const": ["frame", "cx", "cy", "half_w", "half_h"] },
    "note": { "type": "string" },
    "source": { "type": "string" },
    "shots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 2,
        "additionalProperties": { "$ref": "#/$defs/track" }
      }
    }
  }
}
