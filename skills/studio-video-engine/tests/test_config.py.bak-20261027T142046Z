CARTOON = "jenniejoy_cartoon_3d"
LIVE = "newtecons_live_action"
V003 = "seedvr2/v003-7b-int8-tile768-int17-raw21"


def _build(world):
    return loader.build_config(world.episode_file, skill_root=world.skill_root,
                               machine_path=world.machine_path)


def _resolve(world):
    return loader.resolve_episode(str(world.episode_file), skill_root=world.skill_root,
                                  machine_path=world.machine_path)


def _overrides(world, **pairs):
    world.edit_episode(lambda d: d["overrides"].update(pairs))


# ---- the real episode -------------------------------------------------------------------
def test_real_ep04_config_validates_and_is_stable() -> None:
    first = loader.build_config(REAL_EPISODE_ENGINE / "episode.json")
    second = loader.build_config(REAL_EPISODE_ENGINE / "episode.json")
    assert first.violations == () and first.config is not None
    assert first.config.config_sha256 == second.config.config_sha256
    config = first.config
    assert config.domain["domain_id"] == CARTOON
    assert config.recipes["seedvr2"]["recipe_id"] == V003
    assert len(config.shots) == 14
    assert sum(shot["clip"]["frames"] for shot in config.shots) == 1656
    assert set(config.sources) >= {"machine", "episode", "shots", "mouth-boxes"}


