def test_live_action_with_the_cartoon_recipe_is_refused_at_config_level(tmp_path: Path) -> None:
    world = make_live_action_world(tmp_path)
    world.edit_episode(lambda d: d["recipes"].update(seedvr2=V003))
    report = _build(world)
    joined = "\n".join(report.violations)
    assert report.config is None
    assert f"recipe {V003} is qualified for domain '{CARTOON}', not '{LIVE}'" in joined
    assert "is not in domain 'newtecons_live_action' allowed_recipes []" in joined
    with pytest.raises(loader.ConfigViolation):
        _resolve(world)


def test_editing_the_live_domain_allow_list_still_cannot_borrow_the_cartoon_recipe(tmp_path: Path) -> None:
    world = make_live_action_world(tmp_path)
    world.edit(world.data(f"domains/{LIVE}.json"), lambda d: d["allowed_recipes"].append(V003))
    world.edit_episode(lambda d: d["recipes"].update(seedvr2=V003))
    joined = "\n".join(_build(world).violations)
    assert "is qualified for domain" in joined  # recipe.domain still pins it to the cartoon domain
    assert "declared fps" not in joined  # no unrelated noise


