def test_shot_and_box_consistency_errors(tmp_path: Path) -> None:
    world = make_world(tmp_path)
    shots = world.engine_dir / "shots.json"
    world.edit(shots, lambda d: d["shots"][3]["clip"].update(frames=127))
    _expect(world, "clip frames sum 1655")
    world.edit(shots, lambda d: d["shots"][3]["clip"].update(frames=128))
    world.edit(shots, lambda d: d["shots"][1]["entry"].update(from_shot="S02_A"))
    _expect(world, "is not an earlier shot")
    world.edit(shots, lambda d: d["shots"][1]["entry"].update(from_shot="S01_A", frame=500))
    _expect(world, "beyond S01_A clip length")
    world.edit(shots, lambda d: d["shots"][1]["entry"].update(frame=119))
    world.edit(shots, lambda d: d["shots"][0].update(listener="mother"))
    _expect(world, "speaker and listener are the same")


def test_mouth_box_errors(tmp_path: Path) -> None:
    world = make_world(tmp_path)
    boxes = world.engine_dir / "mouth-boxes.json"
    world.edit(boxes, lambda d: d["shots"]["S01_A"].update(bob=d["shots"]["S01_A"].pop("alice")))
    _expect(world, "no listener track for 'alice'")
    world.edit(boxes, lambda d: d["shots"]["S01_A"].pop("bob"))
    _expect(world, "needs at least 2 propert(ies)")  # schema layer also rejects a one-track shot
    world = make_world(tmp_path / "second")
    world.edit(world.engine_dir / "mouth-boxes.json",
               lambda d: d["shots"]["S01_A"]["mother"]["keyframes"].append([5, 1, 1, 1, 1]))
    _expect(world, "key frames must be increasing")


