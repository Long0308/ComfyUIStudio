def test_recipe_sha_and_geometry_errors(tmp_path: Path) -> None:
    world = make_world(tmp_path)
    path = world.data(f"recipes/{V003}.json")
    world.edit(path, lambda d: d["models"]["vae"].update(sha256="nope"))
    _expect(world, "models.vae.sha256")
    world.edit(path, lambda d: d["models"]["vae"].update(sha256="0" * 64))
    world.edit(path, lambda d: d["geometry"].update(core_frames=12))
    _expect(world, "core + 2*context != max_raw_segment_frames")
    world.edit(path, lambda d: d["geometry"].update(core_frames=13, tile_overlap=900))
    _expect(world, "tile_overlap must be smaller than tile_size")


