@pytest.mark.parametrize("key,value", [
    ("domain.delivery.master.width", 1920),
    ("domain.delivery.master.height", 1080),
    ("domain.frame_rates.delivery_fps", 24),
    ("domain.frame_rates.native_fps", 30),
    ("domain.delivery.master.frames", 1080),
    ("domain.forbid_partner_nodes", False),
    ("domain.forbidden_node_classes", ["ClaudeNode"]),
    ("domain.forbidden_node_classes", ["bfs_body_swap", "bfs_head_swap"]),
    # critic probe 10: a lower-case spelling must not replace (and so remove) "ClaudeNode"
    ("domain.forbidden_node_classes", ["claudenode", "bfs_body_swap", "bfs_head_swap"]),
    ("domain.allowed_custom_nodes", ["comfyui-krea2edit", "newtecons_branding"]),
    ("domain.allowed_recipes", [V003, "seedvr2/other"]),
    ("recipe.seedvr2.geometry.tile_size", 1024),
    ("recipe.seedvr2.geometry.final_width", 1920),
    ("recipe.seedvr2.geometry.core_frames", 17),
    ("recipe.seedvr2.graph_recipe.sampler_steps", 4),
    ("recipe.seedvr2.graph_recipe.sampler_seed", 1),
    ("recipe.seedvr2.models.diffusion.sha256", "0" * 64),
    ("machine.gpu_lock_path", "C:\\elsewhere\\episode-own.lock"),
    ("machine.comfy.url", "http://127.0.0.1:9999"),
    ("domain.not_a_key", 1),
])
def test_episode_cannot_loosen_a_locked_rule(tmp_path: Path, key: str, value) -> None:
    world = make_world(tmp_path)
    _overrides(world, **{key: value})
    report = _build(world)
    assert any(f"override {key!r}" in problem for problem in report.violations), report.violations
    assert report.config is None
    with pytest.raises(loader.ConfigViolation) as caught:
        _resolve(world)
    assert caught.value.exit_code == 1  # refused, nothing sent
    assert isinstance(caught.value, Refused)


