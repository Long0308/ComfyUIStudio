def test_every_allowed_recipe_exists_and_is_owned_by_its_domain() -> None:
    for domain_file in (loader.SKILL_ROOT / "domains").glob("*.json"):
        domain = json.loads(domain_file.read_text("utf-8"))
        for rid in domain["allowed_recipes"]:
            recipe = json.loads((loader.SKILL_ROOT / "recipes" / f"{rid}.json").read_text("utf-8"))
            assert recipe["domain"] == domain["domain_id"]
