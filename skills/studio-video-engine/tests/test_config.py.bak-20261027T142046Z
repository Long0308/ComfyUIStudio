def test_unknown_and_ambiguous_slugs_are_refused(tmp_path: Path) -> None:
    with pytest.raises(Refused):
        loader.find_episode_file("no-such-episode")
    with pytest.raises(Refused):
        loader.find_episode_file("../escape")
    for parent in ("a", "b"):
        target = tmp_path / "production-local" / parent / "dup" / "engine"
        target.mkdir(parents=True)
        (target / "episode.json").write_text("{}", encoding="utf-8")
    with pytest.raises(Refused, match="ambiguous"):
        loader.find_episode_file("dup", repo_root=tmp_path)


