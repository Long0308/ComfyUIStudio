def test_domain_files_carry_the_stated_facts() -> None:
    def read(name):
        return json.loads((loader.SKILL_ROOT / "domains" / f"{name}.json").read_text("utf-8"))
    cartoon, live = read(CARTOON), read(LIVE)
    assert cartoon["frame_rates"] == {"native_fps": 24, "delivery_fps": 30, "mapping": {"num": 5, "den": 4}}
    assert cartoon["delivery"]["master"] == {"width": 3840, "height": 2160, "fps": 30, "duration_s": 84, "frames": 2520}
    assert cartoon["delivery"]["review"] == {
        "width": 1920, "height": 1080, "label": "REVIEW 1080p · native upscaled"}
    assert live["frame_rates"] == {"native_fps": 24, "delivery_fps": 24, "mapping": {"num": 1, "den": 1}}
    assert live["delivery"]["master"]["duration_s"] == 45 and live["delivery"]["master"]["frames"] == 1080
    assert {"ClaudeNode", "bfs_body_swap", "bfs_head_swap"} <= set(cartoon["forbidden_node_classes"])
    assert "ClaudeNode" in live["forbidden_node_classes"]
    assert "newtecons_branding" in live["allowed_custom_nodes"]
    assert not {n for n in cartoon["allowed_custom_nodes"] if n.startswith("newtecons")}
    assert cartoon["allowed_recipes"] == [V003] and live["allowed_recipes"] == []
    assert cartoon["forbid_partner_nodes"] is True and live["forbid_partner_nodes"] is True


